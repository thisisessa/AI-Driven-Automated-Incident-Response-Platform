from datetime import datetime, timedelta
from airflow import DAG
from airflow.operators.python import PythonOperator
import os
import sys

default_args = {
    'owner': 'EduQual_DevSecOps',
    'depends_on_past': False,
    'start_date': datetime(2026, 1, 1),
    'email_on_failure': False,
    'retries': 1,
    'retry_delay': timedelta(minutes=1),
}

dag = DAG(
    'SOAR_Automated_Playbook_Workflow',
    default_args=default_args,
    description='Heartbeat DAG. Manual execution required for threat simulation.',
    schedule_interval=timedelta(seconds=60),  # Yeh har 60 seconds mein trigger HOTA rahega
    catchup=False
)

def heartbeat_wait(**kwargs):
    """Yeh task har 1 minute mein chalega lekin koi fake attack nahi banayega"""
    print("[AIRFLOW HEARTBEAT] Orchestrator is active and waiting for manual threat trigger...")
    print("[AIRFLOW HEARTBEAT] Run 'python3 threat_simulator.py' to generate a new case.")

# Sirf ek dummy task rakha hai taake DAG trigger hota rahe
t1 = PythonOperator(
    task_id='wait_for_manual_trigger', 
    python_callable=heartbeat_wait, 
    provide_context=True, 
    dag=dag
)
